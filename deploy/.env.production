# =============================================================================
# Viraleo — Production Environment Variables
# =============================================================================
# Copy this to .env and fill in your values:
#   cp deploy/.env.production .env
#   nano .env
# =============================================================================

# ── App ──
NODE_ENV=production
APP_URL=https://viraleo.pro
ADMIN_EMAIL=your@email.com

# ── Auth (Google OAuth) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=generate-a-random-64-char-string-here

# ── Database (Upstash Redis) — free at https://upstash.com ──
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ── Google Gemini AI (for pre-analysis) — free tier available ──
GEMINI_KEYS=key1,key2,key3

# ── YouTube API — free from Google Cloud Console ──
YOUTUBE_API_KEY=your-youtube-api-key

# ── Payments (Lemon Squeezy) — get from https://lemonsqueezy.com ──
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_CREATOR=
LEMONSQUEEZY_VARIANT_PRO=

# ── Payouts (Wise API) — optional ──
WISE_API_KEY=
WISE_PROFILE_ID=

# ── Cloudflare (Workers AI + CDN) — optional ──
CF_ACCOUNT_ID=
WORKERS_AI_KEY=

# ── NOT needed on VM (Vercel-only) ──
# VERCEL=1, VERCEL_ENV, VERCEL_URL, etc. — all removed
